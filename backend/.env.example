# ==============================================================================
# AuditRegistry - Backend & AI Microservice Environment Configuration
# ==============================================================================
# SECURITY NOTICE:
# - This file contains sensitive server-side configuration.
# - NEVER commit .env to Git or expose these values to the browser client.
# ==============================================================================

# ----------------- Service Networking -----------------
PORT=8000
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

# ----------------- Database Configuration (PostgreSQL / Supabase) -----------------
# PostgreSQL connection string for connection pooling (Neon / Supabase direct or pooler)
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres?sslmode=require

# Supabase REST and Admin API credentials (NEVER expose to frontend)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder

# ----------------- Security & Authentication -----------------
JWT_SECRET=replace-with-a-secure-random-64-character-hex-string
JWT_ALGORITHM=HS256

# ----------------- AI Anomaly Detector Configuration -----------------
AI_SERVICE_URL=http://localhost:8000
ML_CONTAMINATION_RATE=0.08

# ----------------- Blockchain & RPC Configuration -----------------
BLOCKCHAIN_RPC_URL=https://rpc.sepolia.org
CONTRACT_ADDRESS=0xd8b934580fcE35a11B58C6D73aDeE468a2833fa8
CHAIN_ID=11155111
# Server-side signing private key (OPTIONAL: Only if backend conducts automated relayer anchoring)
# PRIVATE_KEY=
