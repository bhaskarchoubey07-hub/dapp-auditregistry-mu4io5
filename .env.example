# ==============================================================================
# AuditRegistry - Frontend Public Environment Configuration
# ==============================================================================
# SECURITY NOTICE:
# - Only variables prefixed with VITE_ are exposed to the client browser bundle.
# - NEVER put private keys, seed phrases, database passwords, or service-role keys here.
# - Copy this file to .env for local development. DO NOT commit .env to version control.
# ==============================================================================

# ----------------- Supabase Client Configuration -----------------
# Public anonymous credentials for browser-side read/write subject to RLS
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# ----------------- Backend REST API Configuration -----------------
# URL of the FastAPI backend microservice (local development default: http://localhost:8000)
VITE_API_URL=http://localhost:8000

# ----------------- Blockchain & Smart Contract Configuration -----------------
# Public contract address on target EVM network (Sepolia, Hardhat, or Remix VM)
VITE_CONTRACT_ADDRESS=0xd8b934580fcE35a11B58C6D73aDeE468a2833fa8

# Expected numeric EVM Chain ID (11155111 = Ethereum Sepolia, 31337 = Hardhat Local, 1 = Ethereum Mainnet)
VITE_EXPECTED_CHAIN_ID=11155111
VITE_CHAIN_ID=11155111

# Optional fallback public JSON-RPC endpoint for read-only contract calls
VITE_BLOCKCHAIN_RPC_URL=https://rpc.sepolia.org
