# ==============================================================================
# AuditRegistry - Environment Configuration Reference (.env.example)
# ==============================================================================
# SECURITY NOTICE:
# - Variables prefixed with VITE_ are exposed to the client browser bundle.
# - Non-VITE variables (SUPABASE_SERVICE_ROLE_KEY, etc.) are ONLY accessed by 
#   Vercel Serverless Functions in api/ and are NEVER exposed to the client browser.
# - Copy this file to .env for local development. DO NOT commit .env to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL Credentials
# ------------------------------------------------------------------------------
# Serverless Function environment variables (configured in Vercel Dashboard):
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Browser-side credentials (prefixed with VITE_):
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# ------------------------------------------------------------------------------
# 2. Backend REST API Configuration
# ------------------------------------------------------------------------------
# In local development: http://localhost:8000 (or leave blank to use relative /api)
# On Vercel: Leave blank or omit so Vite frontend makes same-origin calls to /api/*
VITE_API_URL=

# ------------------------------------------------------------------------------
# 3. Blockchain & Smart Contract Configuration
# ------------------------------------------------------------------------------
# Contract address deployed on EVM network (Sepolia, Hardhat local, or Ethereum)
CONTRACT_ADDRESS=0xd8b934580fcE35a11B58C6D73aDeE468a2833fa8
VITE_CONTRACT_ADDRESS=0xd8b934580fcE35a11B58C6D73aDeE468a2833fa8

# Target EVM Chain ID (11155111 = Ethereum Sepolia, 31337 = Hardhat Local, 1 = Ethereum Mainnet)
CHAIN_ID=11155111
EXPECTED_CHAIN_ID=11155111
VITE_EXPECTED_CHAIN_ID=11155111
VITE_CHAIN_ID=11155111

# Fallback public JSON-RPC endpoint for read-only contract calls
VITE_BLOCKCHAIN_RPC_URL=https://rpc.sepolia.org
